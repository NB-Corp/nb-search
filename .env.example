# Runtime home directory; defaults to ~/.nb-search.
NB_SEARCH_HOME=
# Canonical JSON configuration path; defaults to $NB_SEARCH_HOME/config.json.
NB_SEARCH_CONFIG=
# Durable async job directory; defaults to $NB_SEARCH_HOME/jobs.
NB_SEARCH_JOBS_ROOT=
# Completed job retention window in hours.
NB_SEARCH_RETENTION_HOURS=72
# Runtime log level: error, warn, info, or debug.
NB_SEARCH_LOG_LEVEL=warn

# Exa API credential.
NB_SEARCH_EXA_API_KEY=
# Exa API base URL override.
NB_SEARCH_EXA_BASE_URL=

# Tavily API credential.
NB_SEARCH_TAVILY_API_KEY=
# Tavily API base URL override.
NB_SEARCH_TAVILY_BASE_URL=

# Optional Jina Reader API credential.
NB_SEARCH_JINA_API_KEY=
# Jina Reader API base URL override.
NB_SEARCH_JINA_BASE_URL=

# Firecrawl API credential.
NB_SEARCH_FIRECRAWL_API_KEY=
# Firecrawl API base URL override.
NB_SEARCH_FIRECRAWL_BASE_URL=

# Brave Search API credential.
NB_SEARCH_BRAVE_API_KEY=
# Brave Search API base URL override.
NB_SEARCH_BRAVE_BASE_URL=

# Optional Context7 API credential.
NB_SEARCH_CONTEXT7_API_KEY=

# Zhipu Web Search API credential.
NB_SEARCH_ZHIPU_API_KEY=
# Zhipu Web Search API base URL override.
NB_SEARCH_ZHIPU_BASE_URL=

# Optional GitHub token for higher rate limits.
NB_SEARCH_GITHUB_TOKEN=

# Parallel Search API credential.
NB_SEARCH_PARALLEL_API_KEY=

# Required SearXNG instance base URL.
NB_SEARCH_SEARXNG_BASE_URL=

# OpenAI-compatible API credential.
NB_SEARCH_OAC_API_KEY=
# Required OpenAI-compatible API base URL.
NB_SEARCH_OAC_BASE_URL=
# Required OpenAI-compatible synthesis model.
NB_SEARCH_OAC_MODEL=

# Grok Responses API credential.
NB_SEARCH_GROK_API_KEY=
# Grok Responses API base URL override.
NB_SEARCH_GROK_BASE_URL=
# Grok Responses API model override.
NB_SEARCH_GROK_MODEL=

# Required Grok Multi-Agent Chat Completions base URL.
NB_SEARCH_GROK_MULTI_AGENT_BASE_URL=
# Grok Multi-Agent model override.
NB_SEARCH_GROK_MULTI_AGENT_MODEL=
