NB_SEARCH_EXA_API_KEY=
NB_SEARCH_TAVILY_API_KEY=
# EXA_API_KEY and TAVILY_API_KEY are supported fallbacks.
NB_SEARCH_EXA_BASE_URL=
NB_SEARCH_TAVILY_BASE_URL=
# EXA_API_BASE/EXA_API_URL and TAVILY_API_BASE/TAVILY_API_URL are supported fallbacks.
NB_SEARCH_EXA_TIMEOUT_MS=
NB_SEARCH_EXA_RESEARCH_LIGHT_TIMEOUT_MS=60000
NB_SEARCH_TAVILY_TIMEOUT_MS=
# Grok uses a fixed retrieval-only Chat Completions request. Both an endpoint and key are required.
NB_SEARCH_GROK_BASE_URL=
NB_SEARCH_GROK_API_KEY=
NB_SEARCH_GROK_MODEL=grok-4.1-fast
NB_SEARCH_GROK_TIMEOUT_MS=30000
# GROK_API_URL, GROK_API_KEY, GROK_MODEL, and SEARCH_LAYER_GROK_TIMEOUT_SECONDS are supported fallbacks.
# Grok Multi-Agent is asynchronous-only. Enabling it selects deep analysis research jobs; missing URL/key inherit direct Grok.
NB_SEARCH_GROK_MULTI_AGENT_ENABLED=false
NB_SEARCH_GROK_MULTI_AGENT_BASE_URL=
NB_SEARCH_GROK_MULTI_AGENT_API_KEY=
NB_SEARCH_GROK_MULTI_AGENT_MODEL=grok-4.20-multi-agent-xhigh
NB_SEARCH_GROK_MULTI_AGENT_EFFORT=xhigh
NB_SEARCH_GROK_MULTI_AGENT_REPLACE_GROK=false
NB_SEARCH_GROK_MULTI_AGENT_TIMEOUT_MS=240000
# GROK_MULTI_AGENT_MODEL, GROK_MULTI_AGENT_EFFORT, GROK_MULTI_AGENT_REPLACE, and SEARCH_LAYER_GROK_MULTI_AGENT_TIMEOUT_SECONDS are supported fallbacks.
# Aggregate cutover stays disabled until the flag, endpoint, and token are all set.
NB_SEARCH_GATEWAY_BASE_URL=
NB_SEARCH_GATEWAY_TOKEN=
NB_SEARCH_GATEWAY_AGGREGATE=false
NB_SEARCH_GATEWAY_PROFILE=
NB_SEARCH_GATEWAY_TIMEOUT_MS=
NB_SEARCH_RETRY_MAX_ATTEMPTS=
NB_SEARCH_RETRY_BACKOFF_MS=
NB_SEARCH_RETRY_MAX_BACKOFF_MS=
NB_SEARCH_HOME=
# Optional canonical JSON path; defaults to $NB_SEARCH_HOME/config.json when present.
NB_SEARCH_CONFIG=
# Optional durable job directory; defaults to $NB_SEARCH_HOME/jobs.
NB_SEARCH_JOBS_ROOT=
# Optional legacy search-layer JSON path. The first existing legacy candidate is used.
SEARCH_LAYER_CREDENTIALS=
NB_SEARCH_LOG_LEVEL=warn
NB_SEARCH_RETENTION_HOURS=72
