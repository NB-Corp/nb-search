{
  "name": "@nb-corp/nb-search",
  "version": "0.4.0",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "description": "Deterministic search, fetch, and capability lane runtime",
  "license": "MIT",
  "homepage": "https://github.com/NB-Corp/nb-search#readme",
  "bugs": {
    "url": "https://github.com/NB-Corp/nb-search/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NB-Corp/nb-search.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.33.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./SKILL.md": "./SKILL.md"
  },
  "bin": {
    "nb-search": "./dist/cli.mjs",
    "nb-search-mcp": "./dist/mcp.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "docs/assets",
    "CHANGELOG.md",
    "SKILL.md",
    ".env.example",
    "docs/model-facing-lane-runtime.md",
    "docs/remote-protocol.md",
    "docs/cli.md",
    "scripts/nb-search.mjs",
    "examples/script-lane",
    "skills/nb-search"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run",
    "smoke": "node scripts/smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "docs:build": "pnpm --dir website build",
    "docs:check": "pnpm --dir website check",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "playwright": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsdown": "0.22.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  }
}
